%% ============================================================
%% Recruitment Assistant - Hybrid Flowchart
%% Role 5B: Flowchart Architect
%% Current scope: Phase 1 -> Phase 3 demo
%% ============================================================

%% Source files checked:
%% - src/app.py
%% - src/prompts.py
%% - src/tools.py
%% - src/providers.py
%% - src/mock_data.py
%% - config/test_cases.json
%%
%% Important Phase 3 note:
%% The current ReAct path is a deterministic demo in run_react_agent().
%% It uses real recruitment tools and mock_data.py, but does not yet parse LLM actions dynamically.

flowchart TD
    subgraph P1["Phase 1 - Hybrid Decision Draft"]
        U1["User Query"] --> D1{"Question type?"}
        D1 -->|"Simple / enough chat context"| B1["Baseline Chatbot"]
        D1 -->|"Needs CV/JD/schedule data"| R1["ReAct Agent"]
    end

    subgraph P2["Phase 2 - Baseline Chatbot Path"]
        U2["User Query"] --> RBC["run_baseline_chatbot(user_query, provider)<br/>src/app.py"]
        RBC --> BP["CHATBOT_BASELINE_PROMPT<br/>src/prompts.py"]
        BP --> LLM2["LLM Provider<br/>provider.generate(...)<br/>src/providers.py"]
        LLM2 --> F2["Final Answer"]

        BC["Baseline constraints<br/>Tool calls: 0<br/>Action: none<br/>Observation: none<br/>ReAct loop: none"]
        RBC -.-> BC
    end

    subgraph P3["Phase 3 - ReAct Agent Demo Path"]
        U3["Demo Query"] --> RAG["run_react_agent(user_query, provider)<br/>src/app.py"]
        RAG --> S1["Step 1 Thought<br/>Need candidate evidence"]
        S1 --> A1["Action<br/>get_candidate_profile[CV_001]"]
        A1 --> O1["Observation<br/>candidate profile from CANDIDATES_DB"]

        O1 --> S2["Step 2 Thought<br/>Need job requirements"]
        S2 --> A2["Action<br/>get_job_requirements[backend_senior]"]
        A2 --> O2["Observation<br/>JD from JOBS_DB"]

        O2 --> S3["Step 3 Thought<br/>Compare CV with JD"]
        S3 --> A3["Action<br/>evaluate_fit[CV_001, backend_senior]"]
        A3 --> O3["Observation<br/>fit score and evidence"]

        O3 --> S4["Step 4 Thought<br/>Schedule demo interview"]
        S4 --> A4["Action<br/>check_interview_schedule[2026-08-05]"]
        A4 --> O4["Observation<br/>available slots"]
        O4 --> A5["Action<br/>schedule_interview[CV_001, 2026-08-05, 09:00, backend_senior]"]
        A5 --> O5["Observation<br/>booking confirmation"]
        O5 --> A6["Action<br/>send_notification[CV_001, interview_scheduled]"]
        A6 --> O6["Observation<br/>mock notification status"]
        O6 --> F3["Final Answer"]
    end

    subgraph TR["Tool Registry Snapshot"]
        REG["AVAILABLE_TOOLS<br/>src/tools.py"]
        REG --> T1["get_candidate_profile"]
        REG --> T2["get_job_requirements"]
        REG --> T3["evaluate_fit"]
        REG --> T4["check_interview_schedule"]
        REG --> T5["schedule_interview"]
        REG --> T6["send_notification"]
        REG --> T7["get_interview_status"]
    end

%% Phase 3 invariants verified against current source:
%% - run_react_agent() uses implemented recruitment tools and mock data.
%% - Baseline path calls provider.generate() and does not call tools.
%% - ReAct demo is deterministic and does not yet include a dynamic LLM Action Parser.
%% - MAX_ITERATIONS is configured in src/prompts.py; current demo prints four major steps.
